# ============================================================
# AcousticBuild Frontend — variables de entorno (copie a .env)
# ============================================================

# URL/endereco del backend (API).
# - PRODUCCION (Vercel): defina con la URL del backend en Render, ej.:
# VITE_API_URL=https://acousticbuild-api.onrender.com
#
# - DESARROLLO local: si NO la setea, ya cae automaticamente en
#   http://localhost:8000 (no necesita declararla aqui).