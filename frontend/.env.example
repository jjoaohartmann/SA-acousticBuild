# ============================================================
# AcousticBuild Frontend — variáveis de ambiente (copie para .env)
# ============================================================

# URL da API/backend usado pelo frontend.
# - Em PRODUCAO (front e back no MESMO dominio da Vercel): deixe vazio -> origem relativa ''.
# - Em DESENVOLVIMENTO: se nao setar, ja cai automaticamente em http://localhost:8000.
#
# Sobrescreva apenas se o backend estiver em outro dominio:
# VITE_API_URL=https://sua-api.vercel.app